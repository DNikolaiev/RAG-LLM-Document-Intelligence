{
  "name": "caselens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/api",
    "apps/mcp",
    "apps/web",
    "apps/worker",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:typecheck": "tsc --noEmit -p apps/web/e2e/tsconfig.json",
    "typecheck": "turbo run typecheck",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:e2e:typecheck && npm test && npm run build",
    "fixtures:generate": "python scripts/generate-fixtures.py",
    "fixtures:verify": "python scripts/verify-fixtures.py"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
