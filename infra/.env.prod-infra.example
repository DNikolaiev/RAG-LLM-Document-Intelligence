# Copy this file to infra/.env.prod-infra and replace every example secret.
# The resulting infra/.env.prod-infra file is ignored by Git.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_PORT=6379

MINIO_ROOT_USER=caselens-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
